<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!--
      Web context of the servlet named "mvc-dispatcher" (default file name
      /WEB-INF/[servlet-name]-servlet.xml). Child of the root context.
      Declaring any HandlerMapping bean here disables DispatcherServlet default
      mappings (including RequestMappingHandlerMapping), so annotations would be ignored.
    -->

    <!-- Handler adapter: knows how to call Controller implementations
         (it invokes HelloController.handleRequest, which calls handleRequestInternal). -->
    <bean id="handlerAdapter"
          class="org.springframework.web.servlet.mvc.SimpleControllerHandlerAdapter"/>

    <!-- The handler. Its bean id is what MyHandlerMapping matches on. -->
    <bean id="helloController" class="com.example.plumbing.web.HelloController">
        <!-- greetingService is not in this file: it is resolved from the parent (root) context -->
        <constructor-arg ref="greetingService"/>
    </bean>

    <!-- Handler mapping: maps /hello and /bye to helloController (see MyHandlerMapping). -->
    <bean id="myHandlerMapping" class="com.example.plumbing.web.MyHandlerMapping"/>

    <!--
      Alternative: pure-XML URL mapping instead of the custom class.
    <bean id="urlMapping"
          class="org.springframework.web.servlet.handler.SimpleUrlHandlerMapping">
        <property name="mappings">
            <props>
                <prop key="/hello">helloController</prop>
            </props>
        </property>
    </bean>
    -->

    <!-- View resolver: logical name "hello" becomes /WEB-INF/views/hello.jsp -->
    <bean id="viewResolver"
          class="org.springframework.web.servlet.view.InternalResourceViewResolver">
        <property name="prefix" value="/WEB-INF/views/"/>
        <property name="suffix" value=".jsp"/>
    </bean>

</beans>
